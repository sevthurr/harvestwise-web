# =============================================================================
# EXAMPLE — client/.env.example
# Safe to commit. Copy to .env.local or .env.development for local dev.
# Vite automatically exposes variables prefixed with VITE_ to the client bundle.
# =============================================================================

# --- Backend API Configuration ----------------------------------------------
# Local standalone backend (running uvicorn directly on port 8000):
# VITE_API_URL=http://localhost:8000
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Local Docker backend (API container mapped to host port 8080):
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Production backend:
# VITE_API_URL=https://api.yourdomain.com
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# --- Supabase (Google OAuth broker) -------------------------------------------
# Used by the PKCE browser client (@supabase/supabase-js) for
# signInWithOAuth({ provider: 'google' }) + exchangeCodeForSession().
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key from Supabase Dashboard → Project Settings → API>
# (anon public is safe for the client bundle; never use the service_role key.)
